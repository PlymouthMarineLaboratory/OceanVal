# %% tags=["remove-input"]
sea = first["seasonal"]
md("## Seasonal cycles")

# %% tags=["remove-input"]
years = years_text(sea)
md(
    f"The seasonal cycle of {name} is the mean of each month of the year over {years}, {sr.files_text(entry, 'seasonal')}. "
    + sr.series_area_text(info, sea, entry, "seasonal")
    + " "
    + sr.dates_text(entry, "seasonal")
)

# %% tags=["remove-input"]
if not globals().get("regions_mapped", False) and info.get("subregions"):
    drawn = sp.region_map(results_dir)
    if drawn:
        sp.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        display(md(f"**Figure {i_figure}**: The regions the time series are taken over."))
        i_figure += 1
    regions_mapped = True

# %% tags=["remove-input"]
for layer, saved in sea["layers"].items():
    display(md(f"### {saved['title']}"))
    where = sr.WHERE[layer]
    layer_units = ap.unit_html(saved["units"])
    drawn = sp.seasonal_cycle_regions(results_dir, variable, layer)
    sp.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
    display(md(
        f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}"
        + (", over the full domain and each of its regions" if sea["regions"] else ", over the full domain")
        + ", a line for each simulation."
    ))
    i_figure += 1
    drawn = sp.station_plot(results_dir, variable, "seasonal", layer)
    if drawn:
        sp.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        caption = drawn.found.get("caption")
        if caption:
            display(md(
                f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}, at {caption}, a line for each simulation."
            ))
        else:
            display(md(
                f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}, in the model cell nearest each station, a line for each simulation."
            ))
        i_figure += 1
