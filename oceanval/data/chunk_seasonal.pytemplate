# %% tags=["remove-cell"]
ds1 = ds_model.copy()
ds1.cdo_command("setname,model")
ds1.run()
ds2 = ds_obs.copy()
ds2.cdo_command("setname,observation")
ds2.run()
ds_cor = nc.open_data([ds1.current[0], ds2.current[0]])
ds_cor.merge(match=["month"])
ds_cor.run()
ds_ts = ds_cor.copy()
ds_cor.cor_time("model", "observation")
title = f"Seasonal temporal correlation between {variable} for model and observations"
ds_cor.run()

# output to nc

out = f"../../oceanval_results/temporals/{variable}_cor_{source}.nc"
if not os.path.exists(os.path.dirname(out)):
    os.makedirs(os.path.dirname(out))
ds_cor.to_nc(out, zip = True, overwrite = True)
out_def = f"../../oceanval_results/temporals/{variable}_cor_{source}.pkl"
with open(out_def, "wb") as f:
    pickle.dump(definitions, f)

# %% tags=["remove-input"]

df_cor = ds_cor.to_dataframe().reset_index()
if not wanted("seasonal_cor_map"):
    pass
elif fix_grid:
    ds_cor_plot = ds_cor.copy()
    ds_cor_plot.to_latlon(lon = [lon_min , lon_max], lat = [lat_min, lat_max], res = [lon_res, lat_res])
    _fig = figures.method(ds_cor_plot, "pub_plot", "cor", land = "lightgrey")
    land_below()
    figures.show(i_figure)
else:
    _fig = figures.method(ds_cor, "pub_plot", "cor", land = "lightgrey")
    land_below()
    figures.show(i_figure)

# %% tags=["remove-input"]
if wanted("seasonal_cor_map"):
    md(f"**Figure {i_figure}**: Seasonal temporal correlation between model and observations for {layer} {vv_name}. This is the Pearson correlation coefficient between climatological monthly mean values in the model and observations.{cor_note}", gallery="Seasonal correlation of model and observations")
    i_figure += 1

# %% tags=["remove-cell"]
lon_range = lon_max - lon_min
lat_range = lat_max - lat_min

global_grid = False
if lon_range > 340:
    if lat_range > 160:
        global_grid = True

# %% tags=["remove-cell"]

# %% tags=["remove-cell"]
#shape = gpd.read_file(f"{data_dir}/mapping/TM_WORLD_BORDERS-0.3.shp")
mod_var = ds_model.variables[0]
obs_var = ds_obs.variables[0]
# create xlim using mod_var
try:
    time_name = [x for x in list(ds_model.to_xarray().coords) if "time" in x][0]
except:
    time_name = None
    concise = True
if len(ds_model.times) == 1:
    concise = True
    time_name = None
    model_unit = ""
    xlim = "bar"
    ylim = "ba"
if time_name is not None:
    # the monthly climatologies as tables (oceanval.report_maps, which the monthly maps draw from too)
    from oceanval import report_maps
    df_model, df_obs, df_diff, xlim, ylim = report_maps.seasonal_frames(ds_model, ds_obs)
    try:
        model_unit = ds_model.contents.unit[0]
        model_unit = fix_unit(model_unit)
    except:
        model_unit = ds_obs.contents.unit[0]
        model_unit = fix_unit(model_unit)

    # %% tags=["remove-input"]

    if not concise and wanted("monthly_maps"):
        md(f"The seasonal cycles of simulated and observed {vv_name} are compared in Figure {i_figure} below. This figure shows the model and observation average in each month of the year, and the differences between the two each month") 

# %% tags=["remove-input"]
# global maps are twice as wide as they are tall, so show them four months at a time, not six
if global_grid:
    seasonal_periods = [range(1, 5), range(5, 9), range(9, 13)]
else:
    # half of the months available in each figure, or one figure for 5 or fewer
    available = sorted({int(month) for month in df_model.month})
    half = (len(available) + 1) // 2
    seasonal_periods = [available] if len(available) <= 5 else [available[:half], available[half:]]

if not concise and wanted("monthly_maps"):
    # a line separates each group of months from the next, but none follows the last group
    seasonal_periods = [x for x in seasonal_periods if set(x) & set(df_model.month)]
    # the monthly maps of each group of months (oceanval.report_maps)
    from oceanval import report_maps
    for i, months in enumerate(seasonal_periods):
        _fig = figures.call(
            report_maps.seasonal_month_maps, ds_model, ds_obs, list(months),
            report_maps.unit_label(variable, model_unit),
            divider = i < len(seasonal_periods) - 1,
            fixed_scale = "fixed_scale_value" == "True",
            global_grid = bool(global_grid),
        )
        if _fig is not None:
            figures.show(i_figure)

# %% tags=["remove-input"]
if not concise and wanted("monthly_maps"):
    fixed_scale = "fixed_scale_value"
    arrows = " Arrows on the colorbars indicate values beyond the colorbar limits."
    if fixed_scale == "False":
        md(f"**Figure {i_figure}**: Monthly mean {layer} {vv_name} for the model, observation and the difference between model and observations. For clarity, the maximum values are capped to the 98th percentiles.{arrows}{months_note}", gallery="Monthly maps: model, observations and difference")
    else:
        md(f"**Figure {i_figure}**: Monthly mean {layer} {vv_name} for the model, observation and the difference between model and observations. For clarity, the maximum and minimum values are capped to cover the 98th and 2nd percentiles of both model and observations.{arrows}{months_note}", gallery="Monthly maps: model, observations and difference")
    i_figure += 1
