# %% tags=["remove-input"]
sea = entry["seasonal"]
md("## Seasonal time series")

# %% tags=["remove-input"]
years = years_text(sea)
md(
    f"The seasonal time series of {name} is its mean in each month from {years}, read from {sea['files']} file{'s' if sea['files'] != 1 else ''}. "
    + series_area_text(info, sea)
    + " "
    + dates_text(sea)
)

# %% tags=["remove-input"]
for layer, saved in sea["layers"].items():
    display(md(f"### {saved['title']}"))
    where = {"surface": "surface", "bottom": "bottom", "mean": "depth-averaged", "integral": "depth-integrated"}[layer]
    layer_units = ap.unit_html(saved["units"])
    drawn = ap.seasonal_series_plot(results_dir, variable, layer)
    ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
    display(md(
        f"**Figure {i_figure}**: Monthly mean {where} {name} ({layer_units}), {years}"
        + (" over the model's domain and each of its regions." if sea["regions"] else " over the model's domain.")
        + " Months with no output are gaps in the lines."
    ))
    i_figure += 1
    drawn = ap.seasonal_cycle_regions(results_dir, variable, layer)
    ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
    display(md(
        f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}"
        + (", over the model's domain and each of its regions." if sea["regions"] else ", over the model's domain.")
    ))
    i_figure += 1
    drawn = ap.station_plot(results_dir, variable, "seasonal", layer)
    if drawn:
        ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        display(md(
            f"**Figure {i_figure}**: Monthly mean {where} {name} ({layer_units}), {years}, in the model cell nearest each station."
        ))
        i_figure += 1
        display(pd.DataFrame(station_rows(saved, info)).style.hide(axis="index"))
        display(md(
            f"**Table {i_table}:** The stations, and the cell of the model's grid with values that is nearest each."
        ))
        i_table += 1
