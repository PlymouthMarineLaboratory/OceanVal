# %% tags=["remove-input"]
sea = entry["seasonal"]
md("## Seasonal cycles")

# %% tags=["remove-input"]
years = years_text(sea)
md(
    f"The seasonal cycle of {name} is the mean of each month of the year over {years}, read from {sea['files']} file{'s' if sea['files'] != 1 else ''}. "
    + series_area_text(info, sea)
    + " "
    + dates_text(sea)
)

# %% tags=["remove-input"]
if not globals().get("regions_mapped", False) and info.get("subregions"):
    drawn = ap.region_map(results_dir)
    if drawn:
        ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        display(md(f"**Figure {i_figure}**: The regions the time series are taken over."))
        i_figure += 1
    regions_mapped = True

# %% tags=["remove-input"]
for layer, saved in sea["layers"].items():
    display(md(f"### {saved['title']}"))
    where = {"surface": "surface", "bottom": "bottom", "mean": "depth-averaged", "integral": "depth-integrated"}[layer]
    layer_units = ap.unit_html(saved["units"])
    drawn = ap.seasonal_cycle_regions(results_dir, variable, layer)
    ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
    display(md(
        f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}"
        + (", over the full domain and each of its regions." if sea["regions"] else ", over the full domain.")
    ))
    i_figure += 1
    drawn = ap.station_plot(results_dir, variable, "seasonal", layer)
    if drawn:
        ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        caption = drawn.found.get("caption")
        if caption:
            display(md(
                f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}, at {caption}."
            ))
        else:
            display(md(
                f"**Figure {i_figure}**: The mean seasonal cycle of {where} {name} ({layer_units}): the mean of each month of the year over {years}, in the model cell nearest each station."
            ))
        i_figure += 1
