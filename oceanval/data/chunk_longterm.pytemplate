# %% tags=["remove-input"]
lt = entry["long_term"]
md("## Long-term time series")

# %% tags=["remove-input"]
years = years_text(lt)
md(
    f"The long-term time series of {name} is its mean in each year of {years}, each the mean of the year's monthly means "
    f"(a month of daily output counts as much as a month of monthly output), read from {lt['files']} file{'s' if lt['files'] != 1 else ''}. "
    + series_area_text(info, lt)
    + " "
    + dates_text(lt)
)

# %% tags=["remove-input"]
for layer, saved in lt["layers"].items():
    display(md(f"### {saved['title']}"))
    where = {"surface": "surface", "bottom": "bottom", "mean": "depth-averaged", "integral": "depth-integrated"}[layer]
    layer_units = ap.unit_html(saved["units"])
    drawn = ap.long_term_plot(results_dir, variable, layer)
    ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
    open_circles = (
        f" Open circles are years that are the mean of fewer than 12 months, because the output is missing some: {', '.join(str(y) for y in saved['incomplete'])}."
        if saved["incomplete"] else ""
    )
    gaps = (
        f" There is no output for {', '.join(str(y) for y in saved['missing'])}."
        if saved["missing"] else ""
    )
    display(md(
        f"**Figure {i_figure}**: Annual mean {where} {name} ({layer_units}), {years}"
        + (" over the model's domain and each of its regions." if lt["regions"] else " over the model's domain.")
        + open_circles + gaps
    ))
    i_figure += 1
    drawn = ap.station_plot(results_dir, variable, "long_term", layer)
    if drawn:
        ap.show(drawn, figure_code, f"Figure {i_figure} on the {name} page")
        display(md(
            f"**Figure {i_figure}**: Annual mean {where} {name} ({layer_units}), {years}, in the model cell nearest each station."
        ))
        i_figure += 1
        display(pd.DataFrame(station_rows(saved, info)).style.hide(axis="index"))
        display(md(
            f"**Table {i_table}:** The stations, and the cell of the model's grid with values that is nearest each."
        ))
        i_table += 1
