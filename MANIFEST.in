include LICENSE
include README.md
include setup.py
include pyproject.toml
include requirements.txt
include MANIFEST.in

# Runtime package data (also listed in package_data in setup.py)
include oceanval/data/*

# Keep repo-only material out of the sdist
prune docs
prune docs-site
prune data
prune tests
prune hidden
prune ices
prune .github
exclude claude_updates.md
exclude CLAUDE.md
exclude oceanval.yml
exclude .readthedocs.yaml
exclude .coveragerc
exclude .gitignore

global-exclude __pycache__
global-exclude *.py[cod]
